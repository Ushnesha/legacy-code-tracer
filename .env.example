# Copy this file to .env. The real .env and its variants are ignored by Git.
# Offline mode keeps the API and demo from requesting new AI explanations.
# The explanation CLI also supports ARGS="--offline".
AEROTRACE_OFFLINE=1

# Optional: generate explanations with an OpenAI-compatible provider.
# Set AEROTRACE_OFFLINE=0 for the API/demo when enabling AI requests.
# AEROTRACE_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# AEROTRACE_MODEL=replace-with-a-model-supported-by-your-provider
# AEROTRACE_FAST_MODEL=replace-with-a-model-supported-by-your-provider

# Alternative: generate explanations with Anthropic.
# AEROTRACE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-key
# AEROTRACE_MODEL=replace-with-a-model-supported-by-your-provider
# AEROTRACE_FAST_MODEL=replace-with-a-model-supported-by-your-provider

# Optional paths and client settings; export these in the shell when starting services.
# AEROTRACE_DATA=/absolute/path/to/data
# API_URL=http://localhost:8000
# VITE_API_BASE=http://localhost:8000
